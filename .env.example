# ── Momentum Confidence Score™ ───────────────────────────────────────────────
# Set to 'true' to enable the daily batch scoring job.
# When false (default), the scheduler registers the job but skips execution.
ENABLE_MOMENTUM_SCORE_CALCULATION=false

# Time the daily scoring cron fires (24-hour IST). Default: 16:30.
DAILY_SCORE_HOUR=16
DAILY_SCORE_MINUTE=30

# Maximum symbols processed per run. Keep ≤ 300 for performance.
DAILY_SCORE_BATCH_SIZE=200