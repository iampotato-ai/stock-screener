{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(*)",
      "Edit(app/**)",
      "Edit(templates/**)",
      "Edit(static/**)",
      "Edit(scripts/**)",
      "Edit(*.py)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python *)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:tradingview.com)",
      "WebFetch(domain:nseindia.com)",
      "WebFetch(domain:bseindia.com)",
      "WebFetch(domain:google.com)",
      "Edit(*.json)",
      "Edit(*.md)",
      "Edit(*.txt)",
      "Edit(*.html)",
      "Edit(*.css)",
      "Edit(*.js)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git push origin *)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(pip install -r:*)",
      "Bash(pipenv install:*)",
      "Bash(poetry add:*)",
      "Bash(npm install:*)",
      "Bash(pnpm install:*)",
      "Edit(requirements.txt)",
      "Edit(pyproject.toml)",
      "Edit(setup.py)",
      "Edit(Pipfile)",
      "Edit(package.json)",
      "Edit(package-lock.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(yarn.lock)",
      "Edit(config.py)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(secrets/**)",
      "Edit(credentials/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git checkout -- .*)",
      "Bash(git checkout --force:*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(secrets/**)",
      "Read(secrets/**)",
      "Edit(credentials/**)",
      "Read(credentials/**)",
      "Edit(*.pem)",
      "Read(*.pem)",
      "Edit(*.key)",
      "Read(*.key)",
      "Edit(*.p12)",
      "Read(*.p12)",
      "Edit(*.crt)",
      "Read(*.crt)",
      "Edit(*.cer)",
      "Read(*.cer)",
      "Edit(*.der)",
      "Read(*.der)",
      "Edit(*.jks)",
      "Read(*.jks)",
      "Edit(*.keystore)",
      "Read(*.keystore)",
      "Edit(scan_history.db)",
      "Edit(stocks.db)",
      "Read(scan_history.db)",
      "Read(stocks.db)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(powershell Invoke-WebRequest*)",
      "Bash(powershell Invoke-RestMethod*)"
    ],
    "hooks": [
        {"name": "auto-black", "trigger": "Edit(*.py)", "action": "Bash(black {file})"},
        {"name": "run-pytest-on-edit", "trigger": "Edit(*.py) || Edit(tests/**/*.py)", "action": "Bash(pytest -q)"}
    ]
  }
}